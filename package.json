{
  "name": "effectful-urql",
  "version": "0.1.1",
  "description": "Browser package for urql with Effect-TS integration",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./svelte": {
      "types": "./src/index.svelte.ts",
      "import": "./src/index.svelte.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "keywords": [
    "typescript",
    "urql",
    "effect",
    "browser",
    "graphql"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@urql/core": "^6.0.3",
    "effect": "^4.0.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.2",
    "@graphql-codegen/cli": "^7.4.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "effect": "^4.0.2",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ]
}
